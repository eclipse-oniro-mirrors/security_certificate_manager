import("//base/security/certificate_manager/cert_manager.gni")
import("//build/test.gni")

module_output_path = "certificate_manager/certificate_manager"

ohos_unittest("cm_module_test") {
  module_out_path = module_output_path
  sources = [
    "${cert_manager_root_dir}/services/cert_manager_standard/cert_manager_service/main/os_dependency/idl/cm_ipc/cm_cert_status_event.cpp",

    # production HSDR protocol TU compiled directly into this binary, the
    # cm_cert_status_event.cpp pattern above; the client TU stays out:
    # CmHsdrFetchCloudZip needs a live ability connection, covered on device
    "${cert_manager_root_dir}/services/cert_manager_standard/cert_manager_service/main/os_dependency/cloud/cm_hsdr_protocol.cpp",

    # production sync orchestration TU compiled directly into this binary
    # (the cm_hsdr_protocol.cpp pattern above); every TU it calls is
    # replaced by the symbol stubs in cm_cloud_policy_sync_test.cpp, and
    # its CmThreadPoolPost links the production pool dep below
    "${cert_manager_root_dir}/services/cert_manager_standard/cert_manager_service/main/os_dependency/cloud/cm_cloud_policy_sync.cpp",
    "src/cm_cert_parse_test.cpp",
    "src/cm_cert_status_event_test.cpp",
    "src/cm_cloud_policy_sync_test.cpp",
    "src/cm_data_parcel_processor_test.cpp",
    "src/cm_hsdr_protocol_test.cpp",
    "src/cm_ipc_response_type_test.cpp",
    "src/cm_log_test.cpp",
    "src/cm_param_test.cpp",
    "src/cm_test_pool_seam.cpp",
  ]

  include_dirs = [
    "include",
    "../include",
    "${cert_manager_root_dir}/services/cert_manager_standard/cert_manager_engine/main/core/include",
    "${cert_manager_root_dir}/services/cert_manager_standard/cert_manager_service/main/os_dependency/idl/cm_ipc",
    "${cert_manager_root_dir}/frameworks/cert_manager_standard/main/os_dependency/thread_pool/include",

    # HSDR protocol header (and the cloud store header it includes) for
    # cm_hsdr_protocol_test.cpp and the protocol TU compiled below
    "${cert_manager_root_dir}/services/cert_manager_standard/cert_manager_service/main/os_dependency/cloud/include",
  ]
  cflags_cc = [
    "-Wall",
    "-Werror",
  ]
  cflags = cflags_cc
  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    boundary_sanitize = true
    debug = false
    integer_overflow = true
    ubsan = true
  }

  deps = [ "${cert_manager_root_dir}/interfaces/innerkits/cert_manager_standard/main:cert_manager_sdk" ]

  if (os_level == "standard") {
    deps += [
      "${cert_manager_root_dir}/frameworks/cert_manager_standard/main/common:libcert_manager_common_standard_static",
      "${cert_manager_root_dir}/frameworks/cert_manager_standard/main/common:libcert_manager_openssl_static",
      "${cert_manager_root_dir}/frameworks/cert_manager_standard/main/os_dependency:libcert_manager_ipc_client_static",
      "${cert_manager_root_dir}/frameworks/cert_manager_standard/main/os_dependency:libcert_manager_log_mem_static",

      # the sync TU posts its round through the production pool (the
      # brief's wiring, not the test twin); in this binary the shared
      # pool seam stub (cm_test_pool_seam.cpp) satisfies that symbol
      # first, the archive member is the guarantee behind it
      "${cert_manager_root_dir}/frameworks/cert_manager_standard/main/os_dependency:libcert_manager_thread_pool_static",
      "${cert_manager_root_dir}/services/cert_manager_standard/cert_manager_engine/main/rdb:libcert_manager_rdb_static",
    ]
  }

  # the *ForTest seam macro of this component (thread pool / dialog
  # precedent): the module test needs the sync TU's event publish seam,
  # because this binary already links cm_cert_status_event.cpp, which
  # defines the exported CmPublishForceCheckPolicyUpdatedEvent a symbol
  # stub would collide with
  defines = [ "CM_TEST_API_ENABLE" ]

  external_deps = [
    "ability_base:want",
    "bounds_checking_function:libsec_static",
    "c_utils:utils",
    "googletest:gtest",
    "ipc:ipc_core",
    "ipc:ipc_single",
    "openssl:libcrypto_shared",
  ]
}
