import("//build/ohos.gni")
import("//base/security/certificate_manager/cert_manager.gni")

if (certificate_manager_feature_cmdline_enabled == true) {
  ohos_executable("certmgr") {
    sources = [
      "src/main.cpp",
      "src/certmgr_command.cpp",
    ]

    branch_protector_ret = "pac_ret"
    stack_protector_ret = true
    sanitize = {
      cfi = true
      cfi_cross_dso = true
      debug = false
    }

    defines = []

    deps = [
      "//base/security/certificate_manager/interfaces/innerkits/cert_manager_standard/main:cert_manager_sdk",
    ]

    external_deps = [
      "c_utils:utils",
      "ipc:ipc_single",
      "os_account:os_account_innerkits",
      "os_account:authorization_innerkits",
      "hilog:libhilog",
      "bounds_checking_function:libsec_shared",
      "i18n:intl_util",
    ]

    if (useriam_user_auth_enable) {
      external_deps += [ "user_auth_framework:userauth_client" ]
    }

    subsystem_name = "security"
    output_name = "certmgr"
    install_enable = true
    module_install_dir = "usr/bin"
    part_name = "certificate_manager"
  }

}