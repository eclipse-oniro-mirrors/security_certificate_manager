import("//build/ohos.gni")


ohos_shared_library("ukey_auth_extension_ani") {
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    cfi_vcall_icall_only = true
    cfi_policy = "adaptive"
    debug = false
  }

  branch_protector_ret = "pac_ret"

  include_dirs = [
    "include",
    "//base/security/certificate_manager/frameworks/cert_manager_standard/main/common/include",
    # cm_log.h references cm_type.h (header-only dependency, no innerkit
    # library link, no symbol dependency since a1622fa)
    "//base/security/certificate_manager/interfaces/innerkits/cert_manager_standard/main/include",
  ]

  sources = [
    "src/ets_ukey_auth_extension.cpp",
    "src/ets_ukey_auth_extension_base.cpp",
    "src/ets_ukey_auth_extension_context.cpp",
  ]

  deps = [
    "//base/security/certificate_manager/interfaces/kits/ukey_auth_extension:ukey_auth_extension",
  ]

  external_deps = [
    "ability_base:want",
    "ability_runtime:ability_business_error",
    "ability_runtime:ability_context_native",
    "ability_runtime:ability_manager",
    "ability_runtime:ability_start_options",
    "ability_runtime:abilitykit_native",
    "ability_runtime:ani_base_context",
    "ability_runtime:ani_common",
    "ability_runtime:app_context",
    "ability_runtime:extensionkit_native",
    "ability_runtime:runtime",
    "ability_runtime:ui_extension",
    "ability_runtime:ui_extension_ani",
    "c_utils:utils",
    "eventhandler:libeventhandler",
    "hilog:libhilog",
    "ipc:ipc_napi",
    "ipc:ipc_single",
    "runtime_core:ani",
    "window_manager:libwm",
  ]

  subsystem_name = "security"
  part_name = "certificate_manager"
}
