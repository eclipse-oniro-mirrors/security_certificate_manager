import("//base/security/certificate_manager/cert_manager.gni")
import("//build/ohos.gni")

config("cm_metrics_config") {
  include_dirs = [ "include" ]
}

# libcm_metrics_static:histogram 打点工具,独立模块
# - 不依赖 cm_api_common.h / cm_dialog_api_common.h
# - 调用方在构造 CmMetricsReport 时传入 boundary(通常取 ERROR_CODE_COUNT 或
#   DIALOG_ERROR_CODE_COUNT),Finish 直接使用传入的 errorCode 不做映射
# - CM_API_METRICS_ENABLE 宏和 api_metrics:histogrammanager 依赖只在 libcm_metrics_static 内部使用,
#   静态库链接到消费方后,消费方调用类方法即可,不需要在消费方的 BUILD.gn 中重复声明
ohos_static_library("libcm_metrics_static") {
  branch_protector_ret = "pac_ret"
  sanitize = {
    boundary_sanitize = true
    cfi = true
    cfi_cross_dso = true
    debug = false
    integer_overflow = true
    ubsan = true
    stack_protector_ret = true
  }

  include_dirs = [ "include" ]

  public_configs = [
    ":cm_metrics_config"
  ]

  sources = [ "src/cm_metrics.cpp" ]

  external_deps = [
    "hilog:libhilog"
  ]

  cflags_cc = [
    "-Wall",
    "-Werror",
  ]

  if (cm_api_metrics_enable) {
    cflags_cc += [ "-DCM_API_METRICS_ENABLE" ]
    external_deps += [ "api_metrics:histogrammanager" ]
  }

  part_name = "certificate_manager"
  subsystem_name = "security"
}
