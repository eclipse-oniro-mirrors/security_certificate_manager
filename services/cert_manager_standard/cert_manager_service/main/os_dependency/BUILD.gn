import("//base/security/certificate_manager/cert_manager.gni")
import("//build/ohos.gni")

config("cert_manager_config") {
  include_dirs = [ "sa" ]
}
ohos_static_library("libcert_manager_service_os_dependency_standard_static") {
  subsystem_name = "security"
  part_name = "certificate_manager"
  public_configs = [ ":cert_manager_config" ]
  branch_protector_ret = "pac_ret"
  stack_protector_ret = true
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    boundary_sanitize = true
    debug = false
    integer_overflow = true
    ubsan = true
  }
  include_dirs = [
    "${cert_manager_root_dir}/interfaces/innerkits/cert_manager_standard/main/include",

    # cloud zip module's own header: the TU below includes "cm_cloud_zip.h"
    # relative to this dir (the public config only exposes "sa")
    "cloud/include",
  ]
  defines = []
  sources = [
    "cloud/cm_cloud_zip.cpp",

    # cloud policy store: forceCheck self-heal, version state, tmp dir and
    # atomic publish for the cloud revocation policy sync
    "cloud/cm_cloud_policy_store.cpp",

    # cloud settings query: DataShare settingsdata lookup of the cloud
    # pushed version plus its strict parse and sync gate
    "cloud/cm_cloud_setting_helper.cpp",

    # HSDR protocol: the cmdId=4 request pack / reply parse pair over a
    # raw MessageParcel channel plus the scene table that drives the client
    "cloud/cm_hsdr_protocol.cpp",

    # scene-table-driven HSDR client: connect the service extension, fetch
    # the cloud config zip fd, parse it into a blob
    "cloud/cm_hsdr_client.cpp",

    # cloud policy sync orchestration: the SA-startup round wiring the
    # store self-heal and version state, the settings gate, the HSDR
    # fetch, the whitelisted extraction, the atomic publish and the
    # update event together, with the idle-unload renewal injected by
    # the SA side
    "cloud/cm_cloud_policy_sync.cpp",
    "sa/cm_sa.cpp",
  ]
  deps = [
    "${cert_manager_root_dir}/frameworks/cert_manager_standard/main/common:libcert_manager_common_standard_static",
    "${cert_manager_root_dir}/frameworks/cert_manager_standard/main/os_dependency:libcert_manager_thread_pool_static",
    "${cert_manager_root_dir}/services/cert_manager_standard/cert_manager_engine/main/core:cert_manager_engine_core_standard",
    "${cert_manager_root_dir}/services/cert_manager_standard/cert_manager_engine/main/rdb:libcert_manager_rdb_static",
    "${cert_manager_root_dir}/services/cert_manager_standard/cert_manager_service/main/hisysevent_wrapper:libcert_manager_hisysevent_wrapper_static",
    "dialog:libcm_ukey_auth_dialog_static",
    "idl:libcm_service_idl_standard_static",
  ]

  external_deps = [
    "ability_base:want", # cloud/cm_hsdr_client.cpp (connect Want construction)
    "ability_runtime:ability_connect_callback_stub", # cm_ukey_auth_dialog_manager.h (keep-alive injection)
    "ability_runtime:extension_manager", # cloud/cm_hsdr_client.cpp (service extension connect/disconnect)
    "c_utils:utils",
    "data_share:datashare_consumer", # cloud/cm_cloud_setting_helper.cpp (settingsdata query)
    "eventhandler:libeventhandler",
    "hilog:libhilog",
    "init:libbegetutil", # cm_ukey_dialog_common.h (pc mode check)
    "ipc:ipc_core",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
    "zlib:libz", # cloud/cm_cloud_zip.cpp (minizip unzip side)
  ]

  if (support_jsapi) {
    sources += [ "sa/cm_event_observer.cpp" ]
    defines += [ "SUPPORT_COMMON_EVENT" ]
    external_deps += [
      "ability_base:want",
      "bundle_framework:appexecfwk_base",
      "common_event_service:cesfwk_innerkits",
      "os_account:os_account_innerkits",
    ]
  }
  cflags_cc = [
    "-Wall",
    "-Werror",
  ]
  cflags = cflags_cc
  complete_static_lib = true
}
